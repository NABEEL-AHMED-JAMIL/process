# .env holds real credentials -- the datasource and mail passwords were committed here
# before this line existed. Keep secrets out of the repo; .env.example documents the keys.
!.env.example
*.jks
*.p12


# The .env rule above matches only a file named exactly ".env". A backup copy slipped past it
# once already (.env.bak.<timestamp>) and was committed with real credentials.
.env.bak.*
.env.*.bak
