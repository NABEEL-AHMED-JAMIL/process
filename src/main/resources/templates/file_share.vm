<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="light" />
    <title>A file has been shared with you</title>
  </head>
  <!-- Layout is tables and inline styles on purpose: Outlook renders mail through Word, which
       ignores <style> blocks, flexbox and grid. Everything here survives that. -->
  <body style="margin:0;padding:0;background:#f6f7fb;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
           style="background:#f6f7fb;padding:24px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="560" cellpadding="0" cellspacing="0" border="0"
                 style="width:100%;max-width:560px;background:#ffffff;border:1px solid #dee1ee;
                        border-radius:10px;font-family:Arial,Helvetica,sans-serif;color:#171b2b;">

            <tr><td style="height:3px;background:#4f46e5;border-radius:10px 10px 0 0;
                           font-size:0;line-height:0;">&nbsp;</td></tr>

            <tr>
              <td style="padding:26px 28px 0;">
                <div style="font-size:12px;letter-spacing:0.08em;text-transform:uppercase;
                            color:#8b92ab;font-weight:bold;">ETL Console</div>
                <h1 style="margin:10px 0 0;font-size:19px;line-height:1.3;">
                  $request.get("sender_name") shared something with you</h1>
              </td>
            </tr>

            <tr>
              <td style="padding:16px 28px 0;font-size:14px;line-height:1.6;color:#4e5570;">
                $request.get("attachment_note")
              </td>
            </tr>

            <!-- The sender's own words, set apart so they are not mistaken for our wording. -->
            #if( $request.get("message") && $request.get("message") != "" )
            <tr>
              <td style="padding:16px 28px 0;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td style="padding:12px 14px;background:#f7f8fb;border-left:3px solid #4f46e5;
                               border-radius:0 6px 6px 0;font-size:13px;line-height:1.6;color:#4e5570;">
                      $request.get("message")
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            #end

            <tr>
              <td style="padding:20px 28px 0;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                       style="font-size:14px;border-collapse:collapse;">
                  <tr>
                    <td style="padding:9px 0;color:#6b7392;width:140px;border-bottom:1px solid #eef0f6;">Name</td>
                    <td style="padding:9px 0;border-bottom:1px solid #eef0f6;word-break:break-all;">
                      $request.get("item_name")</td>
                  </tr>
                  <tr>
                    <td style="padding:9px 0;color:#6b7392;border-bottom:1px solid #eef0f6;">Type</td>
                    <td style="padding:9px 0;border-bottom:1px solid #eef0f6;">$request.get("item_type")</td>
                  </tr>
                  <tr>
                    <td style="padding:9px 0;color:#6b7392;">Size</td>
                    <td style="padding:9px 0;">$request.get("size_label")</td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style="padding:22px 28px 26px;">
                <div style="border-top:1px solid #eef0f6;padding-top:16px;font-size:12px;color:#8b92ab;
                            line-height:1.6;">
                  If you were not expecting this, you can ignore it — nothing has been shared with
                  anyone else.
                </div>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
