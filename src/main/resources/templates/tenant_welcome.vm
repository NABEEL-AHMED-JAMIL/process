<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="light" />
    <title>Your workspace is ready</title>
  </head>
  <!-- Layout is tables and inline styles on purpose: Outlook renders mail through Word, which
       ignores <style> blocks, flexbox and grid. Everything here survives that. -->
  <body style="margin:0;padding:0;background:#f6f7fb;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
           style="background:#f6f7fb;padding:24px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="560" cellpadding="0" cellspacing="0" border="0"
                 style="width:100%;max-width:560px;background:#ffffff;border:1px solid #dee1ee;
                        border-radius:10px;font-family:Arial,Helvetica,sans-serif;color:#171b2b;">

            <tr><td style="height:3px;background:#4f46e5;border-radius:10px 10px 0 0;
                           font-size:0;line-height:0;">&nbsp;</td></tr>

            <tr>
              <td style="padding:26px 28px 0;">
                <div style="font-size:12px;letter-spacing:0.08em;text-transform:uppercase;
                            color:#8b92ab;font-weight:bold;">ETL Console</div>
                <h1 style="margin:10px 0 0;font-size:19px;line-height:1.3;">Your workspace is ready</h1>
              </td>
            </tr>

            <tr>
              <td style="padding:16px 28px 0;font-size:14px;line-height:1.6;color:#4e5570;">
                Hello $request.get("contact_name"), the workspace for <strong style="color:#171b2b;">$request.get("organisation_name")</strong> has been set up.
              </td>
            </tr>

            <tr>
              <td style="padding:20px 28px 0;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                       style="font-size:14px;border-collapse:collapse;">
                  <tr>
                    <td style="padding:9px 0;color:#6b7392;width:140px;border-bottom:1px solid #eef0f6;">Sign in at</td>
                    <td style="padding:9px 0;border-bottom:1px solid #eef0f6;word-break:break-all;">
                      <a href="$request.get("sign_in_url")" style="color:#4f46e5;">$request.get("sign_in_url")</a></td>
                  </tr>
                  <tr>
                    <td style="padding:9px 0;color:#6b7392;border-bottom:1px solid #eef0f6;">Username</td>
                    <td style="padding:9px 0;border-bottom:1px solid #eef0f6;word-break:break-all;
                               font-family:Consolas,Menlo,monospace;">$request.get("username")</td>
                  </tr>
                  <tr>
                    <td style="padding:9px 0;color:#6b7392;">One-time password</td>
                    <td style="padding:9px 0;font-family:Consolas,Menlo,monospace;font-size:16px;">
                      <strong>$request.get("temporary_password")</strong></td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style="padding:18px 28px 0;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td style="padding:12px 14px;background:#f7f8fb;border-left:3px solid #4f46e5;
                               border-radius:0 6px 6px 0;font-size:13px;line-height:1.6;color:#4e5570;">
                      This password works once. The console will ask you to choose your own as soon as you sign in, and this one stops working then.
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style="padding:22px 28px 26px;">
                <div style="border-top:1px solid #eef0f6;padding-top:16px;font-size:12px;color:#8b92ab;
                            line-height:1.6;">
                  If you did not ask for this workspace, please tell us and ignore this message.
                </div>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
