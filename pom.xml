            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Swagger -->
        <dependency>
            <groupId>io.springfox</groupId>
            <artifactId>springfox-swagger2</artifactId>
            <version>${swagger.version}</version>
        </dependency>

        <dependency>
            <groupId>io.springfox</groupId>
            <artifactId>springfox-swagger-ui</artifactId>
            <version>${swagger.version}</version>
        </dependency>

        <dependency>
            <groupId>io.springfox</groupId>
            <artifactId>springfox-bean-validators</artifactId>
            <version>${swagger.version}</version>
        </dependency>

        <!-- Kafka -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
            <version>2.5.12.RELEASE</version>
        </dependency>

        <!-- Document Converter: drives the LibreOffice binary installed in Dockerfile to
             convert between office document formats. jodconverter-spring-boot-starter
             autoconfigures the OfficeManager + DocumentFormatRegistry beans from the
             jodconverter.local.* properties (see application-*.properties). -->
        <dependency>
            <groupId>org.jodconverter</groupId>
            <artifactId>jodconverter-spring-boot-starter</artifactId>
            <version>${jodconverter.version}</version>
        </dependency>

        <!-- The starter marks its actual engine implementation as optional; it only ships
             autoconfiguration classes, so jodconverter-local (which pulls in jodconverter-core)
             has to be declared explicitly to get the real conversion classes/OfficeManager. -->
        <dependency>
            <groupId>org.jodconverter</groupId>
            <artifactId>jodconverter-local</artifactId>
            <version>${jodconverter.version}</version>
        </dependency>

        <!-- File Chat: pulls the embedded text layer out of a PDF (Document Converter's own
             output format for office docs) so it can be handed to the AI as plain text, and
             rasterizes a page to an image for the vision-model fallback when there's no text
             layer at all (scanned documents, image-only PDFs). -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>2.0.31</version>
        </dependency>
        <!-- The QR code on an invoice: the number, scannable from the printed page. -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.3</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>3.5.3</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.11.5</version>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Monitoring -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>

        <!-- Query Engine: CSV streaming (CsvExportService) and read-only SQL validation
             (QueryValidator), both pure-Java, no heavyweight transitive deps, both Java 8
             compatible (jsqlparser 4.6 is the last release before its Java 11 floor). -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.10.0</version>
        </dependency>

        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
            <version>4.6</version>
        </dependency>

        <!-- ShedLock -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
            <version>4.9.3</version>
        </dependency>

        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>4.7.1</version>
        </dependency>

        <!-- Apache POI -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>3.15</version>
        </dependency>

        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>3.15</version>
        </dependency>

        <!-- Velocity -->
        <dependency>
            <groupId>org.apache.velocity</groupId>
            <artifactId>velocity</artifactId>
            <version>1.7</version>
        </dependency>

        <dependency>
            <groupId>org.apache.velocity</groupId>
            <artifactId>velocity-tools</artifactId>
            <version>2.0</version>
        </dependency>

        <!-- Utils -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.7</version>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.8.6</version>
        </dependency>

        <!-- Object storage: bucket browser (MinIO / S3 / Azure Blob) -->
        <!-- FTP/FTPS client for the FTP/FTPS StorageConnection providers (commons-net
             version was already declared as a property but the dependency itself was never added). -->
        <dependency>
            <groupId>commons-net</groupId>
            <artifactId>commons-net</artifactId>
            <version>${commons-net.version}</version>
        </dependency>

        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.5.17</version>
        </dependency>

        <!-- minio's own POM transitively pulls okhttp 3.14.9, which fails minio's own
             minimum-okhttp-version runtime check; pin a compatible version directly so it
             wins Maven's dependency resolution over the older transitive one. -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.12.0</version>
        </dependency>

        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>2.25.60</version>
        </dependency>

        <!-- Same SDK and version as s3 above. Outbound mail goes through SES rather than SMTP:
             see process.emailer.SesMailSender for why, and for how it points at LocalStack. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>ses</artifactId>
            <version>2.25.60</version>
        </dependency>

        <!-- Analytics Studio's query engine. Embedded, so there is no server to operate: it runs
             in this JVM and reads object storage over the S3 protocol through its httpfs
             extension, which means a 1 GB scan never streams through Spring. It is deliberately
             not a second application database; see process.analytics.AnalyticsQueryService. -->
        <dependency>
            <groupId>org.duckdb</groupId>
            <artifactId>duckdb_jdbc</artifactId>
            <version>1.1.3</version>
        </dependency>

        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-storage-blob</artifactId>
            <version>12.25.3</version>
        </dependency>

        <!-- Test (JUnit 5 + Mockito + AssertJ, versions managed by parent) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Google's phone number metadata: the per-country digit rules, kept current by
             upstream. Hand-rolled length checks go stale the moment a country adds a range, and
             they cannot tell a valid mobile prefix from an invalid one at the same length. -->
        <dependency>
            <groupId>com.googlecode.libphonenumber</groupId>
            <artifactId>libphonenumber</artifactId>
            <version>8.13.50</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              Build and test on the JDK the application image ships, whatever JVM launched Maven.

              Without this the two drifted: `mvn` ran on a JDK 25 while the image runs 17, so
              surefire forked 25 and every Kafka SASL test failed locally on something that
              cannot happen in production. kafka-clients 2.5 authenticates through
              Subject.getSubject, which went away with the SecurityManager in JDK 24. A build
              that disagrees with what is deployed misleads in both directions, and this is the
              cheap end of fixing that.

              Needs a jdk entry for 17 in ~/.m2/toolchains.xml. The build fails with a clear
              message when there is none, which is the intended outcome: silently compiling
              against the wrong JDK is what this exists to stop.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>toolchain</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <toolchains>
                        <jdk>
                            <version>17</version>
                        </jdk>
                    </toolchains>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
      The integration suites, behind a profile.

      WHAT WAS ACTUALLY WRONG. Not "they never run" — run-e2e.sh has been running the five
      *E2EIT classes plus HarnessSmokeIT for a while (86 tests, recorded in README.md), and
      run-kafka-matrix.sh covers KafkaSecurityMatrixIT. What was true is that none of them sit in
      a lifecycle phase: `mvn verify` did not reach one, so nothing could gate a build on them,
      and two classes — ContextProbeIT and OpenSearchRagClientIT — match no script's -Dtest glob
      and had genuinely never executed.

      BEHIND A PROFILE, because every one of them needs infrastructure: Postgres, MinIO,
      LocalStack, Kafka. `mvn verify` on a laptop with no Docker running must not go red, or the
      first thing anybody does is stop running verify.

      Run with: mvn -o verify -Pit
    -->
    <profiles>
        <profile>
            <id>it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <!--
                          Version deliberately omitted. spring-boot-dependencies manages it at the
                          same 2.22.2 it pins surefire to, so the two providers cannot drift apart
                          under this parent, and both are already in the local repository — which
                          is what keeps `mvn -o` working with no new download.
                        -->
                        <configuration>
                            <!--
                              The one line the whole thing turns on. Failsafe runs at
                              integration-test, which is AFTER package — and by then
                              spring-boot-maven-plugin:repackage has replaced the jar with an
                              executable one whose classes live under BOOT-INF/classes/ and which
                              has nothing under process/ at the root. Left unset, Failsafe points
                              at that jar and every IT dies at class-load on process.*.
                            -->
                            <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                            <trimStackTrace>false</trimStackTrace>
                            <excludes>
                                <!--
                                  Cannot pass on the host: every kafka-it listener advertises
                                  host.docker.internal, which the host does not resolve. It has its
                                  own runner, run-kafka-matrix.sh, which is a container on the
                                  broker's own network.
                                -->
                                <exclude>**/KafkaSecurityMatrixIT.java</exclude>
                                <!--
                                  A data generator rather than an assertion. It is gated behind
                                  -Danalytics.generate.sample and would otherwise be swept in by
                                  the defaults and skip noisily on every run.
                                -->
                                <exclude>**/SampleDataGeneratorIT.java</exclude>
                            </excludes>
                        </configuration>
                        <executions>
                            <execution>
                                <id>integration-tests</id>
                                <goals>
                                    <!--
                                      Both goals. integration-test only RECORDS results; verify is
                                      the one that fails the build on them, and a suite that runs
                                      without being able to fail anything is decoration.
                                    -->
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
